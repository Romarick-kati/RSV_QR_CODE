# ===========================================================================
# Everything — frontend AND the backend API (which now runs as a Netlify
# Function, see netlify/functions/api.js) — deploys from this one project.
# Copy this file to .env for local development.
# ===========================================================================

# --- Frontend --------------------------------------------------------------

# Where the frontend sends API requests. Leave this as "/api" for both local
# dev (via `netlify dev`, which runs the function locally too) and
# production on Netlify — it's a relative path, so it always points at
# whatever domain the site itself is served from, avoiding CORS entirely.
VITE_API_URL=/api

# Optional — enables the "Continue with Google" button. Must be the same
# OAuth 2.0 Web Client ID as GOOGLE_CLIENT_ID below. Create one at
# https://console.cloud.google.com/apis/credentials and add this app's
# origin (e.g. http://localhost:8888 for `netlify dev`, or your real
# Netlify URL) as an authorized JavaScript origin. Leave blank to hide the
# Google button.
VITE_GOOGLE_CLIENT_ID=

# Optional — lets the admin "Auto-suggest cover photo" button pull a real,
# content-matched photo from Unsplash instead of a generic themed
# placeholder. Get a free key (50 requests/hour) at
# https://unsplash.com/developers, create an app, and paste the "Access
# Key" here. Leave blank and it still works, just with placeholder photos.
VITE_UNSPLASH_ACCESS_KEY=

# --- Backend (used by the Netlify Function + the seed/admin scripts) ------

# MongoDB connection string — use MongoDB Atlas's free tier:
# https://www.mongodb.com/atlas (create a cluster, add a database user,
# under Network Access allow 0.0.0.0/0 since Netlify Functions don't have a
# fixed IP to allow-list instead). Copy the connection string from
# Atlas → Connect → Drivers.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/presence?retryWrites=true&w=majority"

# Long, random string used to sign JSON Web Tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value or reuse it across environments.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

NODE_ENV=development

# Only relevant if you ever run the backend as a separate standalone server
# instead of a Netlify Function — safe to leave as-is otherwise.
CORS_ORIGIN="http://localhost:5173"

# Optional — enables "Sign in with Google" on the backend side. Leave blank
# to keep it disabled (the frontend button simply won't render).
GOOGLE_CLIENT_ID=""

# --- Admin account -----------------------------------------------------
# The one admin account is provisioned from these three values instead of
# being hard-coded, so YOU control the real login. Set them before your
# first `npm run seed` (or before running `npm run admin:sync`, the safe
# option once you already have real data in the database — see README).
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-before-deploying"

# --- New-signup notifications --------------------------------------------
# Whenever someone creates an account (regular sign-up or first-time Google
# sign-in), the admin dashboard's notification bell shows it immediately —
# this always works, no setup needed.
#
# Optionally, ALSO email you when that happens: create a free account at
# https://resend.com (no card required on the free tier — 3,000 emails/month),
# get an API key, and set it below. Leave blank to skip email entirely.
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="Presence <onboarding@resend.dev>"

# --- SMS reminders (optional) ---------------------------------------------
# Same as the backend .env.example above — see that file for details.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# ===========================================================================
# Deploying to Netlify
# ===========================================================================
# .env files are NOT uploaded to Netlify — they only work for local
# `npm run dev` / `netlify dev`. For the live site, add every variable above
# EXCEPT VITE_API_URL's local value (still set it, just make sure it stays
# "/api") in: Netlify dashboard → Site configuration → Environment variables.
# Make sure they're available to both "Builds" and "Functions" contexts —
# there's a scope selector per variable.
#
# Vite bakes VITE_-prefixed vars in at build time, so changing any of them
# always requires a fresh deploy, not just a page refresh.
