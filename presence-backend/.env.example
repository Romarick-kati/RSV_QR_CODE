# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string.
#
# - If you're using the bundled docker-compose.yml, this matches its default
#   service (db/presence/presence_dev_password), authenticating against the
#   admin database:
MONGODB_URI="mongodb://presence:presence_dev_password@localhost:27017/presence?authSource=admin"
#
# - For a local MongoDB install with no auth configured, it's usually just:
#   MONGODB_URI="mongodb://localhost:27017/presence"
#
# - For MongoDB Atlas (free tier works fine), copy the connection string from
#   Atlas > Connect > Drivers, and swap in your database user's credentials:
#   MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/presence?retryWrites=true&w=majority"

# Long, random string used to sign JSON Web Tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value or reuse it across environments.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Must match the origin the frontend is served from.
CORS_ORIGIN="http://localhost:5173"

# Optional — enables "Sign in with Google". Create an OAuth 2.0 Client ID
# (Web application type) at https://console.cloud.google.com/apis/credentials,
# add http://localhost:5173 as an authorized JavaScript origin, and paste the
# client ID here. Leave blank to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=""

# --- Admin account -----------------------------------------------------
# The one admin account is provisioned from these three values instead of
# being hard-coded, so YOU control the real login. Set them before your
# first `npm run seed` (or before running `npm run admin:sync`, which is
# the safe option once you already have real data in the database — see
# the README's "Admin account" section).
#
# Pick your own values here — these are just placeholders.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-before-deploying"

# --- New-signup notifications --------------------------------------------
# Whenever someone creates an account (regular sign-up or first-time Google
# sign-in), the admin dashboard's notification bell shows it immediately —
# this always works, no setup needed.
#
# Optionally, ALSO email you when that happens: create a free account at
# https://resend.com (no card required on the free tier — 3,000 emails/month),
# get an API key, and set it below. Leave blank to skip email entirely.
RESEND_API_KEY=""
# The "from" address Resend sends as. Their sandbox address below works
# immediately with zero setup; once you verify your own domain on Resend
# you can switch this to something like "Presence <notifications@yourdomain.com>".
NOTIFICATION_EMAIL_FROM="Presence <onboarding@resend.dev>"

# --- SMS reminders (optional) ---------------------------------------------
# When an attendee has a phone number on file (set from their Profile page),
# a confirmation text is sent on RSVP — but only once you configure a real
# SMS gateway here. Africa's Talking (https://africastalking.com) is the
# recommended provider for Cameroon/African numbers; sign up, create an app,
# and paste its username + API key below. Leave blank to skip SMS entirely
# (nothing breaks — it just quietly logs instead of sending).
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# Comma-separated list of origins the API will accept requests from. Add
# every URL the frontend is actually served from (local dev + your deployed
# domain). Example for deploying frontend to Vercel and keeping local dev
# working:
#   CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"
