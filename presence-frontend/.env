# ===========================================================================
# REAL local-dev environment file for Ndi Romarick Kati / Presence.
# This file is already filled in with your details — you only need to do
# ONE thing before it works: paste your MongoDB Atlas cluster address into
# MONGODB_URI below (see the big comment right above it for exact steps).
#
# This file is for LOCAL use only — it is never uploaded to Netlify. For
# the live site, copy every value below into Netlify's dashboard (see the
# "Deploying to Netlify" section at the bottom of this file, and the
# step-by-step in the chat reply).
# ===========================================================================

# --- Frontend --------------------------------------------------------------

# Leave this exactly as-is for both local dev and Netlify.
VITE_API_URL=/api

# Optional — enables the "Continue with Google" button. Leave blank to hide
# it (nothing breaks — the rest of login/register still works normally).
# Get one at https://console.cloud.google.com/apis/credentials:
#   1. Create OAuth client ID -> Web application
#   2. Authorized JavaScript origins: add http://localhost:8888 (for
#      `netlify dev`) and, later, your real https://your-site.netlify.app
#   3. Paste the Client ID (ends in .apps.googleusercontent.com) below
VITE_GOOGLE_CLIENT_ID=

# Optional — lets "Auto-suggest cover photo" pull real photos from Unsplash.
# Free key at https://unsplash.com/developers. Leave blank — everything
# still works fine with placeholder photos instead.
VITE_UNSPLASH_ACCESS_KEY=

# --- Backend (used by the Netlify Function + the seed/admin scripts) ------

# >>> THE ONE THING YOU NEED TO FILL IN <<<
# 1. Go to https://cloud.mongodb.com and log in (or create a free account).
# 2. Create a free (M0) cluster if you don't have one yet.
# 3. Database Access (left sidebar) -> Add New Database User:
#      Username: romarick
#      Password: guidotti.9
#      (Or reuse an existing user with those credentials if you already
#      made one — either way, the password below must match Atlas exactly.)
# 4. Network Access (left sidebar) -> Add IP Address -> Allow Access From
#    Anywhere (0.0.0.0/0) — required because Netlify Functions don't have a
#    fixed IP to individually allow-list.
# 5. Database -> Connect -> Drivers -> copy the connection string. It looks
#    like: mongodb+srv://romarick:<password>@cluster0.ab12cde.mongodb.net/
# 6. Paste it below, replacing ONLY the <cluster-address> part with the real
#    one from step 5 (everything else here is already correct):
MONGODB_URI="mongodb+srv://ndiromarickkati45_db_user:guidotti.9@cluster0.wi7xcld.mongodb.net/presence?retryWrites=true&w=majority&appName=Cluster0"

# Already generated for you — a real random 96-character secret, not a
# placeholder. Safe to use as-is; just don't share this file publicly.
JWT_SECRET="aad25ebd061726c92f836970376c4d400d7bc356ab9e64e304b57fe631027b37920cfa83642586287f1883b0c0d947c7"
JWT_EXPIRES_IN="7d"

NODE_ENV=development

# Only relevant if you ever run the backend as a separate standalone server
# instead of through Netlify — safe to leave as-is otherwise. `netlify dev`
# usually serves the app on :8888, so that's included too.
CORS_ORIGIN="http://localhost:5173,http://localhost:8888"

# Optional — same Client ID as VITE_GOOGLE_CLIENT_ID above. Leave blank to
# keep Google sign-in disabled on the backend too.
GOOGLE_CLIENT_ID=""

# --- Fapshi (Mobile Money payments) ---------------------------------------
# Sandbox keys from your Fapshi dashboard -> Sandbox tab. The "FAK_TEST_"
# prefix on the API key is what makes utils/fapshi.js talk to
# sandbox.fapshi.com instead of live.fapshi.com — no separate env var needed.
# Swap these for your LIVE keys (no FAK_TEST_ prefix) only when you're ready
# to accept real payments.
FAPSHI_API_USER="f03606d7-26d9-4660-bfb4-bb424a46956a"
FAPSHI_API_KEY="FAK_TEST_de12c342f35223b3c032"

# --- Admin account -----------------------------------------------------
# This is YOUR real login as the platform owner (role: ADMIN, sees
# everything). Already filled in with what you gave me.
ADMIN_NAME="Ndi Romarick Kati"
ADMIN_EMAIL="ndiromarickkati45@gmail.com"
ADMIN_PASSWORD="guidotti.9"

# --- New-signup notifications (optional) ----------------------------------
# The in-app notification bell always works with zero setup. To ALSO get an
# email when someone signs up, get a free key at https://resend.com and
# paste it below. Leave blank to skip.
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="Presence <onboarding@resend.dev>"

# --- Ask Presence assistant --------------------------------------------
# Get your own free key from aistudio.google.com/apikey — no card needed,
# it's a rate-limited free tier, not a spend-it-down credit. Blank = the
# assistant button still shows but says it's not set up.
GEMINI_API_KEY=""
ASSISTANT_MODEL="gemini-2.5-flash"

# --- SMS reminders (optional) ---------------------------------------------
# Leave blank to skip entirely — nothing breaks, it just quietly logs
# instead of sending a text.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# ===========================================================================
# Deploying to Netlify
# ===========================================================================
# This .env file is NOT uploaded to Netlify automatically — it only powers
# local `npm run dev` / `netlify dev`. For the LIVE site, go to:
#   Netlify dashboard -> your site -> Site configuration ->
#   Environment variables -> Add a variable
# and add every one of the variables above (same names, same values you
# used here — except swap CORS_ORIGIN to include your real Netlify URL once
# you have it, e.g. "http://localhost:5173,https://your-site.netlify.app").
# Make sure each variable is enabled for both "Builds" and "Functions"
# scopes (there's a scope selector when you add each one).
#
# VITE_-prefixed vars are baked in at build time, so changing any of them on
# Netlify always requires triggering a fresh deploy — a page refresh alone
# won't pick up the change.
