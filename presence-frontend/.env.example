# Base URL of the Presence backend API (see ../presence-backend).
VITE_API_URL=http://localhost:4000/api

# Optional — enables the "Continue with Google" button. Must be the same
# OAuth 2.0 Web Client ID configured as GOOGLE_CLIENT_ID on the backend.
# Create one at https://console.cloud.google.com/apis/credentials and add
# this app's origin (e.g. http://localhost:5173) as an authorized
# JavaScript origin. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
